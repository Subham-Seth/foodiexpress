# ==============================================================================
# FoodieXpress Root .gitignore
# ==============================================================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Dependency Directories
node_modules/
**/node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
**/dist/
frontend/dist/
build/
**/build/
out/
.next/

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploaded Media / User generated files
backend/uploads/*
!backend/uploads/.gitkeep

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# Testing & Coverage
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
.cache
.parcel-cache

# Temporary & Scratch Files
*.tmp
*.temp
scratch/
